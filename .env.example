# Порты сервисов
PERSON_PORT=3001
PROFILE_PORT=3002
WEB_ORIGIN=http://localhost:5173

# Прикладные базы. Кластер поднимается docker-compose.hatchet.yml,
# сами базы создаёт infra/postgres-init/01-create-dbs.sql
PERSON_DATABASE_URL=postgresql://hatchet:password!1@localhost:5432/person
PROFILE_DATABASE_URL=postgresql://hatchet:password!1@localhost:5432/profile

# Межсервисный вызов Person -> Profile
PROFILE_INTERNAL_URL=http://localhost:3002
INTERNAL_SECRET=dev-internal-secret

# Hatchet. Токен берётся из UI на http://localhost:8888
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TLS_STRATEGY=none
